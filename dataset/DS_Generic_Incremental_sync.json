{
	"name": "DS_Generic_Incremental_sync",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorageLS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"FolderName": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@concat(formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.csv')\n",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().FolderName",
					"type": "Expression"
				},
				"fileSystem": "incremental"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}